NODE_ENV=development
PORT=3000

# Coincide con docker-compose.yml (credenciales solo de desarrollo)
DATABASE_URL="postgresql://pgim:pgim@localhost:5432/pgim?schema=public"

# Clave para firmar los tokens de sesión (mínimo 32 caracteres).
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambiar-por-una-clave-de-al-menos-32-caracteres"

# Carpeta de los archivos subidos (modelos RA); por defecto, apps/api/uploads.
# UPLOADS_DIR=uploads

# Proxies de confianza para Express: `loopback` en desarrollo (Vite y el túnel);
# en Railway, 1 (su proxy de borde). Define la IP del rate limit y si la cookie
# lleva Secure.
# TRUST_PROXY=loopback

# Carpeta de la web compilada, relativa a apps/api. Sin valor (desarrollo) la
# web la sirve Vite; en Railway, ../web/dist.
# WEB_DIST=

# Pago de prueba (aprueba al instante, sin cobrar). Siempre activo fuera de
# producción; con true también se habilita en producción, para una demo.
# PAGO_SIMULADO=false

# Mercado Pago, Checkout Pro con credenciales de prueba (solo en .env, nunca en
# el repo). Si falta alguna de las tres se usa el pago de prueba.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# PUBLIC_URL es la URL pública de la app, de donde sale la URL del webhook: en
# desarrollo, la del túnel (npm run tunnel, cambia en cada arranque); en
# producción, la de Railway o el dominio propio.
# PUBLIC_URL=

# Ingreso con Google del comensal. Se crea en Google Cloud > APIs y servicios >
# Credenciales > Crear credenciales > ID de cliente de OAuth > Aplicación web.
# Orígenes autorizados: http://localhost y http://localhost:5173. El túnel rápido
# (npm run tunnel) cambia de URL en cada arranque y no sirve para Google: hace
# falta una URL fija (por ejemplo, un dominio fijo de ngrok) registrada como origen.
# En producción se suma como origen la URL de Railway o el dominio propio.
# GOOGLE_CLIENT_ID=

# Escaneo de platos: proveedor que genera el modelo 3D. El simulado devuelve un
# modelo de demo tras SIMULADO_DEMORA_MS; con SIMULADO_FALLA=true falla siempre.
# PROVEEDOR_3D=simulado
# SIMULADO_DEMORA_MS=20000
# SIMULADO_FALLA=false
# Clave de Tripo (solo en .env, nunca en el repo); con PROVEEDOR_3D=tripo.
TRIPO_API_KEY=
# Cada cuánto se consultan los escaneos en curso y a los cuántos minutos sin
# resultado se dan por fallidos.
# ESCANEO_INTERVALO_MS=10000
# ESCANEO_TIMEOUT_MIN=30
